#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$here/pyproject.toml" ] && grep -q '^name = "skillize"' "$here/pyproject.toml"
then
  exec uv run --project "$here" skillize "$@"
fi
if ! command -v uv >/dev/null 2>&1
then
  echo "skillize: uv is not on PATH" >&2
  exit 1
fi
if [ -n "${SKILLIZE_OFFLINE-}" ]
then
  exec uvx --offline --from git+https://github.com/pleware/skillize.git skillize "$@"
fi
exec uvx --refresh --from git+https://github.com/pleware/skillize.git skillize "$@"
